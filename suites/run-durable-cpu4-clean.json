{
  "suite": "run-durable-cpu4-clean",
  "cluster": {
    "server_machine": "c4d-standard-32-lssd",
    "client_machine": "n2d-standard-32",
    "client_nodes": 12,
    "region": "europe-west4"
  },
  "saturation": {
    "plateau_pct": 5,
    "fleet_cpu": 0.25,
    "repeats": 1,
    "warmup_secs": 8,
    "measure_secs": 15,
    "setup_concurrency": 6,
    "payload_bytes": 256
  },
  "modes": ["wal"],
  "server_configs": {
    "wal": [
      { "label": "cpu4-s4t4", "args": "--wal-shards 4 --worker-threads 4" }
    ]
  },
  "stream_counts": [200000, 500000],
  "pod_ladder": {
    "200000": [160, 250],
    "500000": [400, 625]
  }
}
